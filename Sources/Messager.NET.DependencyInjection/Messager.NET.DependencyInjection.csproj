<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>Messager.NET.DependencyInjection</Title>
        <Authors>NovoDwarf</Authors>
        <Copyright>NovoDwarf</Copyright>
        <TargetFrameworks>net10.0;net9.0</TargetFrameworks>
        <Description>Microsoft.Extensions.DependencyInjection integration for Messager.NET</Description>
        <PackageProjectUrl>https://github.com/NovoDwarf/Messager.NET</PackageProjectUrl>
        <PackageLicenseUrl>https://github.com/NovoDwarf/Messager.NET/blob/master/LICENSE</PackageLicenseUrl>
        <RepositoryUrl>https://github.com/NovoDwarf/Messager.NET</RepositoryUrl>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Messager.NET.Core\Messager.NET.Core.csproj" />
      <ProjectReference Include="..\Messager.NET\Messager.NET.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-preview.3.26207.106" />
    </ItemGroup>

</Project>
